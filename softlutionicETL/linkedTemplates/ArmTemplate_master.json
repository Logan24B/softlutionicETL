{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nombre de instancia de Data Factory",
			"defaultValue": "softlutionicETL"
		},
		"destinoDW_password": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"password\"de \"destinoDW\""
		},
		"origenOLTP_password": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"password\"de \"origenOLTP\""
		},
		"destinoDW_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-softlutionic2.database.windows.net"
		},
		"destinoDW_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "Softlutionic_DW"
		},
		"destinoDW_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adminsoftlutionic"
		},
		"origenOLTP_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-softlutionic2.database.windows.net"
		},
		"origenOLTP_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "softlutionic-sistema-db"
		},
		"origenOLTP_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adminsoftlutionic"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI de la cuenta de almacenamiento que contiene las plantillas de ARM vinculadas."
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Token de SAS para la cuenta de almacenamiento que contiene las plantillas de ARM vinculadas"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "softlutionicETL_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"destinoDW_password": {
						"value": "[parameters('destinoDW_password')]"
					},
					"origenOLTP_password": {
						"value": "[parameters('origenOLTP_password')]"
					},
					"destinoDW_properties_typeProperties_server": {
						"value": "[parameters('destinoDW_properties_typeProperties_server')]"
					},
					"destinoDW_properties_typeProperties_database": {
						"value": "[parameters('destinoDW_properties_typeProperties_database')]"
					},
					"destinoDW_properties_typeProperties_userName": {
						"value": "[parameters('destinoDW_properties_typeProperties_userName')]"
					},
					"origenOLTP_properties_typeProperties_server": {
						"value": "[parameters('origenOLTP_properties_typeProperties_server')]"
					},
					"origenOLTP_properties_typeProperties_database": {
						"value": "[parameters('origenOLTP_properties_typeProperties_database')]"
					},
					"origenOLTP_properties_typeProperties_userName": {
						"value": "[parameters('origenOLTP_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}