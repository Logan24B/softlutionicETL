			"scriptLines": [
				"source(output(",
				"          FacturaIdSource as long,",
				"          DetalleFacturaIdSource as long,",
				"          FechaEmisionKey as integer,",
				"          FechaVencimientoKey as integer,",
				"          ClienteIdSource as long,",
				"          ServicioIdSource as long,",
				"          TipoContratoIdSource as long,",
				"          EstadoFacturaIdSource as long,",
				"          UsuarioIdSource as long,",
				"          ContratoIdSource as long,",
				"          CodigoFact as integer,",
				"          Cantidad as integer,",
				"          PrecioVenta as decimal(18,2)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT\\n    f.id AS FacturaIdSource,\\n    df.id AS DetalleFacturaIdSource,\\n\\n    CONVERT(INT, CONVERT(CHAR(8), f.Fecha_Emision, 112))\\n        AS FechaEmisionKey,\\n\\n    CONVERT(INT, CONVERT(CHAR(8), f.Fecha_Vencimiento, 112))\\n        AS FechaVencimientoKey,\\n\\n    c.ClienteId AS ClienteIdSource,\\n    df.ServicioId AS ServicioIdSource,\\n    c.TipoContratoId AS TipoContratoIdSource,\\n    f.EstadoId AS EstadoFacturaIdSource,\\n    f.UsuarioId AS UsuarioIdSource,\\n    f.ContratoId AS ContratoIdSource,\\n\\n    f.CodigoFact,\\n    df.Cantidad,\\n    CAST(df.PrecioVenta AS DECIMAL(18,2)) AS PrecioVenta\\n\\nFROM dbo.Detalle_Factura df\\nINNER JOIN dbo.Facturas f\\n    ON df.FacturaId = f.id\\n\\nINNER JOIN dbo.Contratos c\\n    ON f.ContratoId = c.id',",
				"     format: 'query') ~> source1",
				"source(output(",
				"          ClienteKey as long,",
				"          ClienteIdSource as long",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: '\\nSELECT\\n    ClienteKey,\\n    ClienteIdSource\\nFROM dbo.DimCliente\\n',",
				"     format: 'query') ~> Odimcliente",
				"source(output(",
				"          ServicioKey as long,",
				"          ServicioIdSource as long",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: '\\nSELECT\\n    ServicioKey,\\n    ServicioIdSource\\nFROM dbo.DimServicio\\n',",
				"     format: 'query') ~> Odimservicio",
				"source(output(",
				"          TipoContratoKey as long,",
				"          TipoContratoIdSource as long",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT\\n    TipoContratoKey,\\n    TipoContratoIdSource\\nFROM dbo.DimTipoContrato',",
				"     format: 'query') ~> Odimtipocontrato",
				"source(output(",
				"          EstadoFacturaKey as long,",
				"          EstadoFacturaIdSource as long",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT\\n    EstadoFacturaKey,\\n    EstadoFacturaIdSource\\nFROM dbo.DimEstadoFactura',",
				"     format: 'query') ~> Odimestadofactura",
				"source(output(",
				"          UsuarioKey as long,",
				"          UsuarioIdSource as long",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT\\n    UsuarioKey,\\n    UsuarioIdSource\\nFROM dbo.DimUsuario',",
				"     format: 'query') ~> Odimusuario",
				"source(output(",
				"          ContratoKey as long,",
				"          ContratoIdSource as long",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: '\\nSELECT\\n    ContratoKey,\\n    ContratoIdSource\\nFROM dbo.DimContrato\\n',",
				"     format: 'query') ~> Odimcontrato",
				"source(output(",
				"          FechaKey as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: '\\nSELECT FechaKey\\nFROM dbo.DimFecha\\n',",
				"     format: 'query') ~> Odimfecha",
				"source1, Odimcliente lookup(source1@ClienteIdSource == Odimcliente@ClienteIdSource,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupdimcliente",
				"lookupdimcliente select(mapColumn(",
				"          FacturaIdSource,",
				"          DetalleFacturaIdSource,",
				"          FechaEmisionKey,",
				"          FechaVencimientoKey,",
				"          ServicioIdSource,",
				"          TipoContratoIdSource,",
				"          EstadoFacturaIdSource,",
				"          ContratoIdSource,",
				"          CodigoFact,",
				"          Cantidad,",
				"          PrecioVenta,",
				"          ClienteKey,",
				"          UsuarioIdSource",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1, Odimservicio lookup(select1@ServicioIdSource == Odimservicio@ServicioIdSource,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupdimservicio",
				"lookupdimservicio select(mapColumn(",
				"          FacturaIdSource,",
				"          DetalleFacturaIdSource,",
				"          FechaEmisionKey,",
				"          FechaVencimientoKey,",
				"          TipoContratoIdSource,",
				"          EstadoFacturaIdSource,",
				"          ContratoIdSource,",
				"          CodigoFact,",
				"          Cantidad,",
				"          PrecioVenta,",
				"          ClienteKey,",
				"          UsuarioIdSource,",
				"          ServicioKey",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2, Odimtipocontrato lookup(select2@TipoContratoIdSource == Odimtipocontrato@TipoContratoIdSource,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupdimtipocontrato",
				"lookupdimtipocontrato select(mapColumn(",
				"          FacturaIdSource,",
				"          DetalleFacturaIdSource,",
				"          FechaEmisionKey,",
				"          FechaVencimientoKey,",
				"          EstadoFacturaIdSource,",
				"          ContratoIdSource,",
				"          CodigoFact,",
				"          Cantidad,",
				"          PrecioVenta,",
				"          ClienteKey,",
				"          UsuarioIdSource,",
				"          ServicioKey,",
				"          TipoContratoKey",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select3, Odimestadofactura lookup(select3@EstadoFacturaIdSource == Odimestadofactura@EstadoFacturaIdSource,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupdimestadofcatura",
				"lookupdimestadofcatura select(mapColumn(",
				"          FacturaIdSource,",
				"          DetalleFacturaIdSource,",
				"          FechaEmisionKey,",
				"          FechaVencimientoKey,",
				"          ContratoIdSource,",
				"          CodigoFact,",
				"          Cantidad,",
				"          PrecioVenta,",
				"          ClienteKey,",
				"          UsuarioIdSource,",
				"          ServicioKey,",
				"          TipoContratoKey,",
				"          EstadoFacturaKey",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select4",
				"select4, Odimusuario lookup(select4@UsuarioIdSource == Odimusuario@UsuarioIdSource,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupdimusuario",
				"lookupdimusuario select(mapColumn(",
				"          FacturaIdSource,",
				"          DetalleFacturaIdSource,",
				"          FechaEmisionKey,",
				"          FechaVencimientoKey,",
				"          ContratoIdSource,",
				"          CodigoFact,",
				"          Cantidad,",
				"          PrecioVenta,",
				"          ClienteKey,",
				"          ServicioKey,",
				"          TipoContratoKey,",
				"          EstadoFacturaKey,",
				"          UsuarioKey",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select5",
				"select5, Odimcontrato lookup(select5@ContratoIdSource == Odimcontrato@ContratoIdSource,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupdimcontrato",
				"lookupdimcontrato select(mapColumn(",
				"          FacturaIdSource,",
				"          DetalleFacturaIdSource,",
				"          FechaEmisionKey,",
				"          FechaVencimientoKey,",
				"          CodigoFact,",
				"          Cantidad,",
				"          PrecioVenta,",
				"          ClienteKey,",
				"          ServicioKey,",
				"          TipoContratoKey,",
				"          EstadoFacturaKey,",
				"          UsuarioKey,",
				"          ContratoKey",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select6",
				"select6, Odimfecha lookup(FechaEmisionKey == FechaKey,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupdimfecha",
				"lookupdimfecha select(mapColumn(",
				"          FacturaIdSource,",
				"          DetalleFacturaIdSource,",
				"          FechaVencimientoKey,",
				"          CodigoFact,",
				"          Cantidad,",
				"          PrecioVenta,",
				"          ClienteKey,",
				"          ServicioKey,",
				"          TipoContratoKey,",
				"          EstadoFacturaKey,",
				"          UsuarioKey,",
				"          ContratoKey,",
				"          FechaEmisionKey = FechaKey",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select7",
				"select7, Odimfecha lookup(FechaVencimientoKey == FechaKey,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup1",
				"lookup1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          FactFacturacionKey as long,",
				"          FechaEmisionKey as integer,",
				"          FechaVencimientoKey as integer,",
				"          ClienteKey as long,",
				"          ServicioKey as long,",
				"          TipoContratoKey as long,",
				"          EstadoFacturaKey as long,",
				"          UsuarioKey as long,",
				"          ContratoKey as long,",
				"          FacturaIdSource as long,",
				"          DetalleFacturaIdSource as long,",
				"          CodigoFact as integer,",
				"          Cantidad as integer,",
				"          PrecioVenta as decimal(18,2),",
				"          ImporteLinea as decimal(37,4),",
				"          FechaCarga as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          FechaEmisionKey,",
				"          FechaVencimientoKey,",
				"          ClienteKey,",
				"          ServicioKey,",
				"          TipoContratoKey,",
				"          EstadoFacturaKey,",
				"          UsuarioKey,",
				"          ContratoKey,",
				"          FacturaIdSource,",
				"          DetalleFacturaIdSource,",
				"          CodigoFact,",
				"          Cantidad,",
				"          PrecioVenta",
				"     )) ~> sink1"
			]
		}
	}
