			"sinks": [
				{
					"dataset": {
						"referenceName": "facttable",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "lookupdimcliente"
				},
				{
					"name": "select1"
				},
				{
					"name": "lookupdimservicio"
				},
				{
					"name": "select2"
				},
				{
