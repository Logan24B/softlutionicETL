				},
				{
					"name": "lookupdimfecha"
				},
				{
					"name": "select7"
				}
			],
			"scriptLines": [
				"source(output(",
				"          FacturaIdSource as long,",
				"          DetalleFacturaIdSource as long,",
				"          FechaEmisionKey as integer,",
				"          FechaVencimientoKey as integer,",
				"          ClienteIdSource as long,",
				"          ServicioIdSource as long,",
				"          TipoContratoIdSource as long,",
				"          EstadoFacturaIdSource as long,",
				"          UsuarioIdSource as long,",
				"          ContratoIdSource as long,",
				"          CodigoFact as integer,",
				"          Cantidad as integer,",
				"          PrecioVenta as decimal(18,2)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT\\n    f.id AS FacturaIdSource,\\n    df.id AS DetalleFacturaIdSource,\\n\\n    CONVERT(INT, CONVERT(CHAR(8), f.Fecha_Emision, 112))\\n        AS FechaEmisionKey,\\n\\n    CONVERT(INT, CONVERT(CHAR(8), f.Fecha_Vencimiento, 112))\\n        AS FechaVencimientoKey,\\n\\n    c.ClienteId AS ClienteIdSource,\\n    df.ServicioId AS ServicioIdSource,\\n    c.TipoContratoId AS TipoContratoIdSource,\\n    f.EstadoId AS EstadoFacturaIdSource,\\n    f.UsuarioId AS UsuarioIdSource,\\n    f.ContratoId AS ContratoIdSource,\\n\\n    f.CodigoFact,\\n    df.Cantidad,\\n    CAST(df.PrecioVenta AS DECIMAL(18,2)) AS PrecioVenta\\n\\nFROM dbo.Detalle_Factura df\\nINNER JOIN dbo.Facturas f\\n    ON df.FacturaId = f.id\\n\\nINNER JOIN dbo.Contratos c\\n    ON f.ContratoId = c.id',",
				"     format: 'query') ~> source1",
				"source(output(",
				"          ClienteKey as long,",
				"          ClienteIdSource as long,",
				"          Nombre as string,",
				"          Apellido as string,",
				"          NombreCompleto as string,",
				"          Cedula as string,",
				"          Telefono as string,",
				"          Correo as string,",
				"          Direccion as string,",
				"          Departamento as string,",
				"          EstadoCliente as boolean,",
				"          FechaRegistro as date,",
				"          HoraRegistro as timestamp,",
				"          FechaCarga as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> Odimcliente",
				"source(output(",
				"          ServicioKey as long,",
				"          ServicioIdSource as long,",
				"          NombreServicio as string,",
				"          Descripcion as string,",
				"          PrecioLista as decimal(18,2),",
				"          Duracion as string,",
				"          FechaCarga as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> Odimservicio",
				"source(output(",
				"          TipoContratoKey as long,",
				"          TipoContratoIdSource as long,",
				"          Nombre as string,",
				"          Descripcion as string,",
				"          FechaCarga as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> Odimtipocontrato",
				"source(output(",
				"          EstadoFacturaKey as long,",
				"          EstadoFacturaIdSource as long,",
				"          Estado as string,",
				"          FechaCarga as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> Odimestadofactura",
				"source(output(",
				"          UsuarioKey as long,",
				"          UsuarioIdSource as long,",
				"          Username as string,",
				"          PrimerNombre as string,",
				"          SegundoNombre as string,",
				"          NombreCompleto as string,",
				"          Rol as boolean,",
				"          IsSuperuser as boolean,",
				"          IsStaff as boolean,",
				"          IsActive as boolean,",
				"          FechaRegistro as date,",
				"          HoraRegistro as timestamp,",
				"          FechaCarga as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> Odimusuario",
				"source(output(",
				"          ContratoKey as long,",
				"          ContratoIdSource as long,",
				"          ClienteIdSource as long,",
				"          TipoContratoIdSource as long,",
				"          FechaInicio as date,",
				"          FechaFin as date,",
				"          EstadoContrato as boolean,",
				"          Descripcion as string,",
				"          FechaCarga as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> Odimcontrato",
				"source(output(",
				"          FechaKey as integer,",
				"          Fecha as date,",
				"          Dia as integer,",
				"          DiaSemana as integer,",
				"          NombreDia as string,",
				"          Mes as integer,",
				"          NombreMes as string,",
				"          Trimestre as integer,",
				"          Anio as integer,",
				"          EsFinSemana as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> Odimfecha",
				"source1, Odimcliente lookup(source1@ClienteIdSource == Odimcliente@ClienteIdSource,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupdimcliente",
				"lookupdimcliente select(mapColumn(",
				"          FacturaIdSource,",
				"          DetalleFacturaIdSource,",
				"          FechaEmisionKey,",
				"          FechaVencimientoKey,",
				"          ServicioIdSource,",
				"          TipoContratoIdSource,",
				"          EstadoFacturaIdSource,",
				"          ContratoIdSource,",
				"          CodigoFact,",
				"          Cantidad,",
				"          PrecioVenta,",
				"          ClienteKey,",
				"          UsuarioIdSource",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1, Odimservicio lookup(select1@ServicioIdSource == Odimservicio@ServicioIdSource,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupdimservicio",
				"lookupdimservicio select(mapColumn(",
				"          FacturaIdSource,",
				"          DetalleFacturaIdSource,",
				"          FechaEmisionKey,",
				"          FechaVencimientoKey,",
				"          TipoContratoIdSource,",
				"          EstadoFacturaIdSource,",
				"          ContratoIdSource,",
				"          CodigoFact,",
				"          Cantidad,",
				"          PrecioVenta,",
				"          ClienteKey,",
				"          UsuarioIdSource,",
				"          ServicioKey",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2, Odimtipocontrato lookup(select2@TipoContratoIdSource == Odimtipocontrato@TipoContratoIdSource,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupdimtipocontrato",
				"lookupdimtipocontrato select(mapColumn(",
				"          FacturaIdSource,",
				"          DetalleFacturaIdSource,",
				"          FechaEmisionKey,",
				"          FechaVencimientoKey,",
				"          EstadoFacturaIdSource,",
				"          ContratoIdSource,",
				"          CodigoFact,",
				"          Cantidad,",
				"          PrecioVenta,",
				"          ClienteKey,",
				"          UsuarioIdSource,",
				"          ServicioKey,",
				"          TipoContratoKey",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select3, Odimestadofactura lookup(select3@EstadoFacturaIdSource == Odimestadofactura@EstadoFacturaIdSource,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupdimestadofcatura",
				"lookupdimestadofcatura select(mapColumn(",
				"          FacturaIdSource,",
				"          DetalleFacturaIdSource,",
				"          FechaEmisionKey,",
				"          FechaVencimientoKey,",
				"          ContratoIdSource,",
				"          CodigoFact,",
				"          Cantidad,",
				"          PrecioVenta,",
				"          ClienteKey,",
				"          UsuarioIdSource,",
				"          ServicioKey,",
				"          TipoContratoKey,",
				"          EstadoFacturaKey",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select4",
				"select4, Odimusuario lookup(select4@UsuarioIdSource == Odimusuario@UsuarioIdSource,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupdimusuario",
				"lookupdimusuario select(mapColumn(",
				"          FacturaIdSource,",
				"          DetalleFacturaIdSource,",
				"          FechaEmisionKey,",
				"          FechaVencimientoKey,",
				"          ContratoIdSource,",
				"          CodigoFact,",
				"          Cantidad,",
				"          PrecioVenta,",
				"          ClienteKey,",
				"          UsuarioIdSource = select4@UsuarioIdSource,",
				"          ServicioKey,",
				"          TipoContratoKey,",
				"          EstadoFacturaKey,",
				"          UsuarioKey",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select5",
				"select5, Odimcontrato lookup(select5@ContratoIdSource == Odimcontrato@ContratoIdSource,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupdimcontrato",
				"lookupdimcontrato select(mapColumn(",
				"          FacturaIdSource,",
				"          DetalleFacturaIdSource,",
				"          FechaEmisionKey,",
				"          FechaVencimientoKey,",
				"          CodigoFact,",
				"          Cantidad,",
				"          PrecioVenta,",
				"          ClienteKey,",
				"          UsuarioIdSource,",
				"          ServicioKey,",
				"          TipoContratoKey,",
				"          EstadoFacturaKey,",
				"          UsuarioKey,",
				"          ContratoKey",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select6",
				"select6, Odimfecha lookup(FechaEmisionKey == FechaKey,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupdimfecha",
				"lookupdimfecha select(mapColumn(",
				"          FacturaIdSource,",
				"          DetalleFacturaIdSource,",
				"          FechaVencimientoKey,",
				"          CodigoFact,",
				"          Cantidad,",
				"          PrecioVenta,",
				"          ClienteKey,",
				"          ServicioKey,",
				"          TipoContratoKey,",
				"          EstadoFacturaKey,",
				"          UsuarioKey,",
				"          ContratoKey,",
				"          FechaKey",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select7",
				"select7 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          FactFacturacionKey as long,",
				"          FechaEmisionKey as integer,",
				"          FechaVencimientoKey as integer,",
				"          ClienteKey as long,",
				"          ServicioKey as long,",
				"          TipoContratoKey as long,",
				"          EstadoFacturaKey as long,",
				"          UsuarioKey as long,",
				"          ContratoKey as long,",
				"          FacturaIdSource as long,",
				"          DetalleFacturaIdSource as long,",
				"          CodigoFact as integer,",
				"          Cantidad as integer,",
				"          PrecioVenta as decimal(18,2),",
				"          ImporteLinea as decimal(37,4),",
				"          FechaCarga as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          FechaEmisionKey = FechaKey,",
				"          FechaVencimientoKey,",
				"          ClienteKey,",
				"          ServicioKey,",
				"          TipoContratoKey,",
				"          EstadoFacturaKey,",
				"          UsuarioKey,",
				"          ContratoKey,",
				"          FacturaIdSource,",
				"          DetalleFacturaIdSource,",
				"          CodigoFact,",
				"          Cantidad,",
				"          PrecioVenta",
				"     )) ~> sink1"
			]
		}
	}
}